{
  "permissions": {
    "allow": [
      "Bash(git push origin:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:api:*)",
      "Bash(npx tsc --noEmit:*)"
    ],
    "deny": [
      "Read(./uploads/samples/**)",
      "Read(./**/*.pdf)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf:*)",
      "Bash(docker compose down -v:*)"
    ]
  }
}
